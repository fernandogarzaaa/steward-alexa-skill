# Steward environment template. Copy to .env and export it (e.g. `set -a; . ./.env; set +a`).
# The code reads these from the process environment; all are optional (see README "Environment variables").
STEWARD_DB=
STEWARD_MCP_HOST=
STEWARD_MCP_PORT=
STEWARD_MCP_URL=
STEWARD_WEB_HOST=
STEWARD_WEB_PORT=
STEWARD_MODEL_PROVIDER=
STEWARD_BEDROCK_MODEL_ID=
STEWARD_AWS_REGION=
STEWARD_MODEL_BASE_URL=
STEWARD_MODEL_API_KEY=
STEWARD_MODEL_ID=
# Hosted demo (see README "Deploy"); the Docker image sets the first two.
PORT=
STEWARD_DEMO_MODE=
STEWARD_DEMO_RESET_HOURS=
STEWARD_DEMO_MAX_SESSIONS=
STEWARD_DEMO_IDLE_MINUTES=
STEWARD_DEMO_MAX_CHARS=
